OPENWEATHER_API_KEY=replace-with-your-openweather-key
OPENWEATHER_ZIP_CODE=68164
OPENWEATHER_COUNTRY_CODE=us
OPENWEATHER_UNITS=imperial
OPENWEATHER_TIMEOUT_SECONDS=10
# Cache weather results in seconds (example: 900 = 15 minutes)
OPENWEATHER_REFRESH_SECONDS=900

# Agenda strip (Google Calendar API key works with calendars shared as public)
SMARTDISPLAY_AGENDA_ENABLED=1
GOOGLE_CALENDAR_AUTH_MODE=service_account
# API key mode (public calendar only)
GOOGLE_CALENDAR_API_KEY=replace-with-google-calendar-api-key
# Service account mode (private calendar). Keep keys outside the repo tree.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=/home/pi/smartdisplay_secrets/google-service-account.json
# Optional alternative to FILE: full JSON in one env var
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
# Optional Workspace domain-wide delegation subject
GOOGLE_CALENDAR_SERVICE_ACCOUNT_SUBJECT=
GOOGLE_CALENDAR_EVENTS_ID=replace-with-events-calendar-id
GOOGLE_CALENDAR_REMINDERS_ID=replace-with-reminders-calendar-id
GOOGLE_CALENDAR_EVENTS_LABEL=Event
GOOGLE_CALENDAR_REMINDERS_LABEL=Reminder
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10
GOOGLE_CALENDAR_REFRESH_SECONDS=300
GOOGLE_CALENDAR_LOOKAHEAD_DAYS=7
GOOGLE_CALENDAR_MAX_ITEMS=4

# Use static/images by default or point to an external folder on the Pi.
SMARTDISPLAY_IMAGE_DIR=/home/pi/smartdisplay_website/static/images
SMARTDISPLAY_REFRESH_SECONDS=60
SMARTDISPLAY_LAYOUT_MODE=single
# Options: none, postcard_drop, postcard_drop_topdown
SMARTDISPLAY_TRANSITION_MODE=none
SMARTDISPLAY_UPLOAD_ENABLED=0
SMARTDISPLAY_UPLOAD_TOKEN=replace-with-random-upload-token
# Optional: override QR target URL. Leave blank to use request host.
SMARTDISPLAY_PUBLIC_BASE_URL=
SMARTDISPLAY_SHOW_UPLOAD_QR=1
SMARTDISPLAY_MAX_UPLOAD_MB=20
SMARTDISPLAY_HOST=0.0.0.0
SMARTDISPLAY_PORT=5000
