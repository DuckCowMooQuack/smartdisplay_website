OPENWEATHER_API_KEY=replace-with-your-openweather-key
OPENWEATHER_ZIP_CODE=68164
OPENWEATHER_COUNTRY_CODE=us
OPENWEATHER_UNITS=imperial
OPENWEATHER_TIMEOUT_SECONDS=10

# Use static/images by default or point to an external folder on the Pi.
SMARTDISPLAY_IMAGE_DIR=/home/pi/smartdisplay_website/static/images
SMARTDISPLAY_REFRESH_SECONDS=60
SMARTDISPLAY_HOST=0.0.0.0
SMARTDISPLAY_PORT=5000
